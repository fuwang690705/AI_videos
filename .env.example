# 本地开发配置。复制为项目根目录 .env，勿提交真实密钥。
STUDIO_ENVIRONMENT=local
STUDIO_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# 不设置时使用 apps/api/.data/studio.db（SQLite）。
# 启动 PostgreSQL 后可启用此行，并重新运行迁移：
# STUDIO_DATABASE_URL=postgresql+psycopg://studio:studio_local@127.0.0.1:5432/studio
STUDIO_TEMPORAL_ADDRESS=127.0.0.1:7233
STUDIO_TEMPORAL_NAMESPACE=default
STUDIO_TEMPORAL_TASK_QUEUE=studio-production
# Next.js 服务端代理目标；浏览器统一通过同源 /api 访问。
STUDIO_API_ORIGIN=http://127.0.0.1:8000
# 本地样片需要 FFmpeg / ffprobe；默认从 PATH 查找，无需 Docker。
# STUDIO_FFMPEG_PATH=ffmpeg
# STUDIO_FFPROBE_PATH=ffprobe
# 不设置时使用 apps/api/.data/media。备份时需与数据库一起保存。
# STUDIO_MEDIA_ROOT=/absolute/path/to/local-media

